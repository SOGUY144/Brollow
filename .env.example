# Copy to .env.local. Leave the Supabase values empty to run in demo mode.

# -----------------------------------------------------------------------------
# 1. Supabase (Database, Authentication, Row Level Security & Storage)
# -----------------------------------------------------------------------------
# Public values (safe in the browser; access is enforced by PostgreSQL RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/script only. Used by `npm run seed:live`. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 2. AI Smart Kit Builder & Voice AI Consultant (Optional — graceful fallback)
# -----------------------------------------------------------------------------
# OpenAI API key for GPT-4o-mini intelligent kit curation (`/api/ai-kit`).
# Falls back to the deterministic local rule-based planner if omitted.
OPENAI_API_KEY=

# ElevenLabs API key for Voice Input (`scribe_v1` STT) and Voice Advice (`eleven_v4_turbo` TTS)
# supporting native Thai and English (`/api/elevenlabs/stt` & `/api/elevenlabs/tts`).
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# 3. Site Configuration
# -----------------------------------------------------------------------------
# Public address of the site for canonical links, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://brollow.vercel.app
